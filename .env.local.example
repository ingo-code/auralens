ANTHROPIC_API_KEY=

# Supabase (Auth, DB, Storage). For local dev run `npx supabase start`
# and copy the printed "Project URL" / "Publishable" key here
# (older CLI versions print API_URL / ANON_KEY - both key types work). For a hosted project,
# use the values from your Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public API v1 (/api/v1): Supabase Secret Key (`sb_secret_…`, ältere CLI: service_role key).
# Umgeht Row Level Security - nur serverseitig, nie mit NEXT_PUBLIC_-Präfix!
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Claude-Modell für alle Analysen (Default: claude-opus-5)
# ANTHROPIC_MODEL=
# Optional: Public API v1
# API_JOB_CONCURRENCY=4          # gleichzeitige Analysen pro Server-Prozess
# API_MAX_ACTIVE_ANALYSES=5      # laufende Analysen pro Konto
# API_CREATE_RATE_LIMIT=30       # Analyse-Starts pro Konto und 10 Min
# API_READ_RATE_LIMIT=300        # Lesezugriffe pro Konto und Minute

# Rechtliches (Impressum & Datenschutzerklärung) - siehe docs/RECHTLICHES.md.
# Bewusst nicht im Code, damit die Anschrift nicht im Repository steht.
# Fehlen Name, Anschrift oder E-Mail, zeigen die Seiten einen Warnhinweis.
LEGAL_OPERATOR_NAME=
# Zeilen mit "|" trennen, z. B.: Musterweg 1 | 12345 Musterstadt | Deutschland
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Optional
# LEGAL_PHONE=
# LEGAL_HOSTING=Railway Corp., USA – Server in der EU
# LEGAL_DATABASE=Supabase Inc., USA – Server in Frankfurt (EU)
